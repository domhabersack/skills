{
  "name": "skills",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Agent skills and Claude Code subagents",
  "scripts": {
    "build:agents": "node scripts/build-agents.mjs",
    "check:agents": "node scripts/build-agents.mjs --check",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  }
}
