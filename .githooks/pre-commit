#!/usr/bin/env bash
# Regenerates the opencode agents when the Claude Code agents change, then formats staged markdown
# with Prettier and re-stages everything.
# Installed via `npm install` (the `prepare` script sets core.hooksPath).
set -euo pipefail

require_prettier() {
  if [ ! -x node_modules/.bin/prettier ]; then
    echo "pre-commit: Prettier is not installed. Run 'npm install' first; do not bypass this hook." >&2
    exit 1
  fi
}

# Agents: agents/ (Claude Code) is the source of truth for opencode/agents/ (opencode).
if ! git diff --cached --quiet -- agents; then
  require_prettier
  node scripts/build-agents.mjs
  git add -- opencode/agents
fi

# NUL-separated so names with spaces or non-ASCII characters survive. Renames are included.
# Symlinks (such as AGENTS.md) are skipped: Prettier refuses to format them.
staged_files=()

while IFS= read -r -d '' file; do
  if [ ! -L "$file" ]; then
    staged_files+=("$file")
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md')

if [ ${#staged_files[@]} -eq 0 ]; then
  exit 0
fi

require_prettier

# Re-staging a partially staged file would stage changes that were left out on purpose.
partially_staged=()

for file in "${staged_files[@]}"; do
  if ! git diff --quiet -- "$file"; then
    partially_staged+=("$file")
  fi
done

if [ ${#partially_staged[@]} -gt 0 ]; then
  echo "pre-commit: these markdown files have unstaged changes, so they cannot be formatted automatically:" >&2
  printf '  %s\n' "${partially_staged[@]}" >&2
  echo "Stage or stash the remaining changes, or run 'npm run format' and stage the result." >&2
  exit 1
fi

# With `set -e`, a Prettier failure aborts the commit instead of letting unformatted files through.
node_modules/.bin/prettier --write --log-level warn "${staged_files[@]}"
git add -- "${staged_files[@]}"
